# Copy to .env and generate your own secrets (never use example values in production):
#   cp .env.example .env
#   openssl rand -base64 32   # POSTGRES_PASSWORD
#   openssl rand -base64 48   # AUTH_TOKEN_SECRET

POSTGRES_USER=interesme
POSTGRES_PASSWORD=
POSTGRES_DB=interesme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AUTH_TOKEN_SECRET=

# Optional JWT settings (defaults: InteresMe / InteresMe.Client)
# JWT_ISSUER=InteresMe
# JWT_AUDIENCE=InteresMe.Client

# Google OAuth Web Client ID for frontend Google Sign-In.
# Where to get it:
#   Google Cloud Console -> APIs & Services -> Credentials
#   Create Credentials -> OAuth client ID -> Application type: Web application
#   Copy the value named "Client ID" and paste it below.
#
# Authorized JavaScript origins must include the frontend URL used in browser:
#   http://localhost:4201   # Docker Compose default
#   http://localhost:4200   # Angular local dev server, if used directly
#
# Do NOT paste "Client secret" here. Google Client Secret must never be used in Angular/frontend config.
GOOGLE_CLIENT_ID=

# Frontend dev server port exposed by Docker Compose.
FRONTEND_PORT=4201
